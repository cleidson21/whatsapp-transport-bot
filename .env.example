# ==========================================
# POSTGRESQL DATABASE CONFIGURATION
# ==========================================
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=your_postgres_password_here

# ==========================================
# EVOLUTION API CONFIGURATION
# ==========================================
AUTHENTICATION_API_KEY=your_evolution_api_global_key_here
SERVER_URL=http://localhost:8080

# ==========================================
# WHATSAPP HUB BOT CONFIGURATION
# ==========================================
# Evolution API endpoint reachable by the bot container
WHATSAPP_API_URL=http://evolution_api:8080
WHATSAPP_API_KEY=your_evolution_api_global_key_here
WHATSAPP_INSTANCE=transporte-hub

# Language for messages sent to WhatsApp groups ('pt' for Portuguese, 'en' for English)
BOT_LANGUAGE=pt

# Optional override (if not defined, uses grupo_coordenacao from config.json)
WHATSAPP_COORDINATION_GROUP="Coordination Dispatch Group"
