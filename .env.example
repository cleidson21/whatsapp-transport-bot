# ==========================================
# CONFIGURAÇÕES DO BANCO DE DADOS (POSTGRES)
# ==========================================
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=evolution_secret_pass

# ==========================================
# CONFIGURAÇÕES DA EVOLUTION API
# ==========================================
AUTHENTICATION_API_KEY=Transporte_Universitario_2026_Secreta
SERVER_URL=http://localhost:8080

# ==========================================
# CONFIGURAÇÕES DO HUB BOT
# ==========================================
# URL da Evolution API acessível pelo bot no Docker (ou http://localhost:8080 fora do Docker)
WHATSAPP_API_URL=http://evolution_api:8080
WHATSAPP_API_KEY=Transporte_Universitario_2026_Secreta
WHATSAPP_INSTANCE=sec-educ-berimbau

# Opcional (se não definido, usa o grupo_coordenacao do config.json)
WHATSAPP_COORDINATION_GROUP="Operação Transporte Universitário"
